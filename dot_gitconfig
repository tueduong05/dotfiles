[user]
    name = Tue Duong
    email = tueduong005@gmail.com
    signingkey = ~/.ssh/id_ed25519.pub
[commit]
    gpgsign = true
[init]
    defaultBranch = main
[filter "lfs"]
    required = true
    clean = git-lfs clean -- %f
    process = git-lfs filter-process
    smudge = git-lfs smudge -- %f
[gpg]
    format = ssh
[pull]
    rebase = true
[push]
    autoSetupRemote = true

[include]
    path = ~/.gitconfig.local
